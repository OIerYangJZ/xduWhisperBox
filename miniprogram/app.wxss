page {
  --app-primary: #155e75;
  --app-primary-dark: #4dd0e1;
  --app-accent: #e06c4e;
  --app-background: #ffffff;
  --app-surface: #ffffff;
  --app-card: #ffffff;
  --app-text-primary: #1d1d1f;
  --app-text-secondary: #8e8e93;
  --app-text-tertiary: #c7c7cc;
  --app-divider: #e8e8e8;
  --app-success: #34c759;
  --app-warning: #ff9500;
  --app-error: #ff3b30;
  --app-control: rgba(142, 142, 147, .12);
  --app-primary-soft: rgba(21, 94, 117, .1);
  --app-accent-soft: rgba(224, 108, 78, .12);

  min-height: 100vh;
  background: var(--app-background);
  color: var(--app-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: normal;
}

button::after {
  border: none;
}

.page,
.container {
  min-height: 100vh;
  padding: 0;
  background: var(--app-background);
  color: var(--app-text-primary);
}

.theme-light {
  --app-primary: #155e75;
  --app-primary-dark: #4dd0e1;
  --app-accent: #e06c4e;
  --app-background: #ffffff;
  --app-surface: #ffffff;
  --app-card: #ffffff;
  --app-text-primary: #1d1d1f;
  --app-text-secondary: #8e8e93;
  --app-text-tertiary: #c7c7cc;
  --app-divider: #e8e8e8;
  --app-success: #34c759;
  --app-warning: #ff9500;
  --app-error: #ff3b30;
  --app-control: rgba(142, 142, 147, .12);
  --app-primary-soft: rgba(21, 94, 117, .1);
  --app-accent-soft: rgba(224, 108, 78, .12);
}

.theme-dark {
  --app-primary: #4dd0e1;
  --app-primary-dark: #4dd0e1;
  --app-accent: #e06c4e;
  --app-background: #000000;
  --app-surface: #000000;
  --app-card: #000000;
  --app-text-primary: #ffffff;
  --app-text-secondary: #8e8e93;
  --app-text-tertiary: #48484a;
  --app-divider: #2c2c2e;
  --app-success: #34c759;
  --app-warning: #ff9500;
  --app-error: #ff3b30;
  --app-control: rgba(142, 142, 147, .16);
  --app-primary-soft: rgba(77, 208, 225, .16);
  --app-accent-soft: rgba(224, 108, 78, .16);
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.app-section,
.app-card,
.feed-card {
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.app-section {
  padding: 24rpx 28rpx;
}

.app-title {
  color: var(--app-text-primary);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.app-subtitle {
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 1.45;
}

.empty,
.loading-state,
.empty-state,
.no-more {
  padding: 72rpx 32rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
}

.primary-button,
.secondary-button,
.pill-button,
.app-input,
.app-textarea {
  min-height: 44rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-button[disabled],
.send-btn[disabled] {
  background: var(--app-primary-soft) !important;
  color: var(--app-text-secondary) !important;
}

.secondary-button,
.pill-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.app-input,
.app-textarea {
  width: 100%;
  padding: 0 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 20rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 29rpx;
}

.app-input {
  height: 82rpx;
}

.app-textarea {
  min-height: 220rpx;
  padding-top: 18rpx;
  line-height: 1.55;
}

.app-avatar,
.feed-avatar {
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-control);
  color: var(--app-primary);
  text-align: center;
}

.feed-card {
  display: flex;
  gap: 20rpx;
  padding: 14rpx 24rpx;
  background: transparent;
  border-bottom: 1rpx solid var(--app-divider);
}

.feed-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
  object-fit: cover;
}

.feed-body {
  flex: 1;
  min-width: 0;
}

.feed-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.feed-author {
  max-width: 250rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.anonymous-badge {
  flex: 0 0 auto;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: rgba(21, 94, 117, .1);
  color: var(--app-primary);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.feed-channel {
  color: var(--app-primary);
  font-size: 23rpx;
  font-weight: 600;
}

.feed-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  border-radius: 50%;
}

.pin-icon {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  flex: 0 0 auto;
  color: var(--app-primary);
  transform: rotate(35deg);
}

.pin-icon::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 1rpx;
  width: 8rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.pin-icon::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 10rpx;
  width: 2rpx;
  height: 8rpx;
  background: currentColor;
}

.feed-time {
  margin-left: auto;
  color: var(--app-text-tertiary);
  font-size: 22rpx;
}

.feed-title {
  margin-top: 6rpx;
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-summary {
  display: -webkit-box;
  margin-top: 6rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  word-break: break-word;
}

.feed-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.feed-tag {
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.feed-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 48rpx;
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
}

.feed-actions .active {
  color: #ff2d55;
  font-weight: 650;
}

.feed-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.feed-action.share {
  margin-left: auto;
}

.feed-action-icon {
  position: relative;
  flex: 0 0 auto;
  width: 20rpx;
  height: 20rpx;
  color: currentColor;
}

.comment-icon {
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}

.comment-icon::after {
  content: '';
  position: absolute;
  left: 4rpx;
  bottom: -3rpx;
  width: 6rpx;
  height: 6rpx;
  border-left: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.like-icon {
  position: relative;
  width: 12rpx;
  height: 12rpx;
  transform: rotate(-45deg);
  background: currentColor;
  border-radius: 2rpx;
}

.like-icon::before,
.like-icon::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: currentColor;
}

.like-icon::before {
  left: 0;
  top: -4rpx;
  width: 7rpx;
  height: 7rpx;
}

.like-icon::after {
  left: 4rpx;
  top: 0;
  width: 7rpx;
  height: 7rpx;
}

.share-icon {
  width: 16rpx;
  height: 16rpx;
  border-right: 2rpx solid currentColor;
  border-top: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.share-icon::before {
  content: '';
  position: absolute;
  left: -2rpx;
  top: 6rpx;
  width: 11rpx;
  height: 2rpx;
  background: currentColor;
}

.share-icon::after {
  content: '';
  position: absolute;
  right: -1rpx;
  top: 0;
  width: 6rpx;
  height: 6rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.post-tools {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.app-badge,
.badge,
.header-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  background: var(--app-error);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.badge-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--app-error);
}

.app-chip,
.channel-chip,
.sort-chip,
.tag-chip {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: var(--app-control);
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 56rpx;
  white-space: nowrap;
}

.app-chip.active,
.channel-chip.active,
.sort-chip.active,
.tag-chip.active {
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-weight: 600;
}

.menu-list,
.app-list {
  background: var(--app-surface);
}

.menu-item,
.app-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.menu-item:last-child,
.app-list-row:last-child {
  border-bottom: none;
}

.menu-text,
.menu-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
}

.menu-arrow {
  color: var(--app-text-tertiary);
  font-size: 30rpx;
}

.bottom-input-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 120rpx;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--app-surface);
  border-top: 1rpx solid var(--app-divider);
}

.mobile-list-page {
  min-height: 100vh;
  padding: 16rpx 32rpx 64rpx;
  background: var(--app-background);
}

.mobile-tile-card {
  margin-bottom: 32rpx;
  overflow: hidden;
  border: 1rpx solid rgba(232, 232, 232, .5);
  border-radius: 24rpx;
  background: var(--app-card);
}

.theme-dark .mobile-tile-card {
  border-color: rgba(44, 44, 46, .8);
}

.mobile-section-title {
  padding: 0 8rpx 16rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.mobile-tile {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 8rpx 32rpx;
  background: var(--app-card);
}

.mobile-tile + .mobile-tile {
  border-top: 1rpx solid var(--app-divider);
}

.mobile-tile-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  margin-right: 28rpx;
  color: var(--app-text-secondary);
  font-size: 36rpx;
  line-height: 1;
}

.mobile-tile-body {
  flex: 1;
  min-width: 0;
}

.mobile-tile-title {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.mobile-tile-subtitle {
  margin-top: 4rpx;
  color: var(--app-text-tertiary);
  font-size: 24rpx;
  line-height: 1.35;
}

.mobile-tile-arrow {
  margin-left: 16rpx;
  color: var(--app-text-tertiary);
  font-size: 36rpx;
  line-height: 1;
}

.mobile-user-card {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(232, 232, 232, .5);
  border-radius: 32rpx;
  background: var(--app-card);
}

.theme-dark .mobile-user-card {
  border-color: rgba(44, 44, 46, .8);
}

.mobile-user-avatar {
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 120rpx;
  text-align: center;
}

.mobile-user-info {
  flex: 1;
  min-width: 0;
  margin-left: 32rpx;
}

.mobile-user-name {
  color: var(--app-text-primary);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mobile-user-meta {
  margin-top: 4rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

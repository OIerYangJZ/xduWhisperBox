page {
  min-height: 100vh;
  background: #ffffff;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: normal;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 0;
  background: #ffffff;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.empty {
  padding: 96rpx 32rpx;
  color: #8e8e93;
  font-size: 28rpx;
  text-align: center;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  background: #155e75;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(21, 94, 117, .1);
  color: #155e75;
  font-size: 28rpx;
  font-weight: 600;
}

.app-card {
  background: #ffffff;
  border-bottom: 1rpx solid #e8e8e8;
}

.app-section {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #ffffff;
}

.app-title {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.app-subtitle {
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.45;
}

.app-input {
  min-height: 82rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 20rpx;
  background: #ffffff;
  color: #1d1d1f;
  font-size: 29rpx;
}

.feed-card {
  display: flex;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #ffffff;
}

.feed-avatar {
  flex: 0 0 auto;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(21, 94, 117, .12);
  color: #155e75;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
}

.feed-body {
  flex: 1;
  min-width: 0;
}

.feed-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.feed-author {
  max-width: 250rpx;
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.feed-channel {
  font-size: 24rpx;
  font-weight: 550;
}

.feed-time {
  margin-left: auto;
  color: #c7c7cc;
  font-size: 24rpx;
}

.feed-title {
  margin-top: 8rpx;
  color: #1d1d1f;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
}

.feed-summary {
  margin-top: 8rpx;
  color: #1d1d1f;
  font-size: 28rpx;
  line-height: 1.5;
}

.feed-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
}

.feed-tag {
  color: #155e75;
  font-size: 25rpx;
  font-weight: 550;
}

.feed-actions {
  display: flex;
  align-items: center;
  gap: 42rpx;
  height: 64rpx;
  margin-top: 12rpx;
  color: #1d1d1f;
  font-size: 26rpx;
}

.feed-actions .active {
  color: #e06c4e;
  font-weight: 650;
}

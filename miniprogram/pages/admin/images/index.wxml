<view class="admin-list">
  <view class="filters">
    <picker mode="selector" range="{{statuses}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="filter">{{statuses[statusIndex].label}}</view>
    </picker>
    <input class="search" placeholder="关键词" value="{{keyword}}" bindinput="onInput" confirm-type="search" bindconfirm="loadData" />
  </view>
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{!rows.length}}" class="empty">暂无图片</view>
  <view class="grid" wx:else>
    <view class="image-card" wx:for="{{rows}}" wx:key="id">
      <image src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="preview"></image>
      <view class="meta">{{item.uploaderAlias || item.uploaderName || '-'}} · {{item.status}}</view>
      <view class="actions">
        <text data-id="{{item.id}}" data-action="approve" bindtap="handleImage">通过</text>
        <text data-id="{{item.id}}" data-action="reject" bindtap="handleImage">驳回</text>
      </view>
    </view>
  </view>
</view>

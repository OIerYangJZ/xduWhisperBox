.admin-list {
  padding: 18rpx;
}

.filters {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.filter,
.search {
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #1d1d1f;
  font-size: 25rpx;
  line-height: 64rpx;
}

.search {
  flex: 1;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.image-card {
  padding: 14rpx;
  border-radius: 16rpx;
  background: #fff;
}

.image-card image {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  background: #f5f5f7;
}

.meta {
  margin-top: 10rpx;
  color: #8e8e93;
  font-size: 23rpx;
}

.actions {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #155e75;
  font-size: 26rpx;
}

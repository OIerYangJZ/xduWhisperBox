<view class="admin-list">
  <view class="filters">
    <picker mode="selector" range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="filter">{{types[typeIndex].label}}</view>
    </picker>
    <picker mode="selector" range="{{statuses}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="filter">{{statuses[statusIndex].label}}</view>
    </picker>
    <input class="search" placeholder="关键词" value="{{keyword}}" bindinput="onInput" confirm-type="search" bindconfirm="loadData" />
  </view>
  <view class="batch">
    <button data-action="approve" bindtap="handleBatch">批量通过</button>
    <button data-action="reject" bindtap="handleBatch">批量驳回</button>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{!rows.length}}" class="empty">暂无审核内容</view>
  <view wx:else>
    <view class="item" wx:for="{{rows}}" wx:key="id">
      <view class="select" data-id="{{item.id}}" bindtap="toggleSelected">{{item.selected ? '✓' : '○'}}</view>
      <view class="body">
        <view class="title">{{item.title || item.content || item.summary || item.id}}</view>
        <view class="meta">{{item.authorAlias || item.authorName || '-'}} · {{item.createdAt || ''}}</view>
        <view class="content">{{item.content || item.reason || ''}}</view>
        <view class="actions">
          <text data-id="{{item.id}}" data-action="approve" bindtap="handleOne">通过</text>
          <text data-id="{{item.id}}" data-action="reject" bindtap="handleOne">驳回</text>
          <text data-id="{{item.id}}" data-action="delete" bindtap="handleOne">删除</text>
        </view>
      </view>
    </view>
  </view>
</view>

.admin-list {
  padding: 18rpx;
}

.filters,
.batch {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.filter,
.search,
.batch button {
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #1d1d1f;
  font-size: 25rpx;
  line-height: 64rpx;
}

.search {
  flex: 1;
}

.batch button {
  flex: 1;
  background: rgba(21, 94, 117, .1);
  color: #155e75;
}

.item {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #fff;
}

.select {
  width: 44rpx;
  color: #155e75;
  font-size: 32rpx;
}

.body {
  flex: 1;
  min-width: 0;
}

.title {
  color: #1d1d1f;
  font-size: 29rpx;
  font-weight: 700;
}

.meta,
.content {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 28rpx;
  margin-top: 16rpx;
  color: #155e75;
  font-size: 26rpx;
}

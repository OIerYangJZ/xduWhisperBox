<view class="page chat-page safe-bottom">
  <scroll-view class="message-list" scroll-y>
    <view class="message {{item.role}}" wx:for="{{messages}}" wx:key="index">
      <view class="bubble">
        <view class="message-content">{{item.content}}</view>
        <view class="hint" wx:if="{{item.hint}}">{{item.hint}}</view>
        <view class="sources" wx:if="{{item.sources && item.sources.length}}">
          <view class="source" wx:for="{{item.sources}}" wx:for-item="source" wx:key="id" data-id="{{source.id}}" bindtap="openSource">
            <view class="source-title">{{source.title}}</view>
            <view class="source-summary">{{source.channel}} · {{source.summary}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="empty small" wx:if="{{loading}}">思考中...</view>
  </scroll-view>

  <view class="input-bar">
    <input value="{{input}}" placeholder="继续提问" confirm-type="send" bindinput="onInput" bindconfirm="send" />
    <button loading="{{loading}}" bindtap="send">发送</button>
  </view>
</view>

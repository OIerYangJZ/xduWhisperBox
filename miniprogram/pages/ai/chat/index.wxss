.ai-chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--app-background);
}

.config-bar,
.model-bar {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  text-align: center;
}

.config-bar {
  background: rgba(255, 149, 0, .12);
  color: var(--app-warning);
}

.model-bar {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.chat-scroll {
  flex: 1;
  overflow-y: hidden;
  padding-bottom: 120rpx;
}

.chat-list {
  padding: 30rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.message-user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
}

.avatar-user {
  background: var(--app-primary-soft);
}

.avatar-assistant {
  background: rgba(142, 142, 147, .14);
}

.message-user .avatar {
  margin-left: 20rpx;
}

.message-assistant .avatar {
  margin-right: 20rpx;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx 30rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 20rpx;
  font-size: 32rpx;
  line-height: 1.5;
  word-wrap: break-word;
}

.message-text {
  white-space: pre-wrap;
}

.references {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(142, 142, 147, .2);
}

.reference-title,
.reference-item {
  color: var(--app-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.reference-title {
  margin-bottom: 8rpx;
  font-weight: 600;
}

.message-user .references {
  border-top-color: rgba(255, 255, 255, .24);
}

.message-user .reference-title,
.message-user .reference-item {
  color: rgba(255, 255, 255, .78);
}

.message-user .message-bubble {
  background: var(--app-primary);
  color: #ffffff;
  border-color: var(--app-primary);
  border-top-right-radius: 4rpx;
}

.message-assistant .message-bubble {
  background: var(--app-surface);
  color: var(--app-text-primary);
  border-top-left-radius: 4rpx;
}

.typing-indicator {
  display: flex;
  align-items: center;
  height: 40rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  border-radius: 50%;
  background: var(--app-text-tertiary);
  animation: typing 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typing {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

.input-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 0 30rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--app-surface);
  border-top: 1rpx solid var(--app-divider);
}

.input {
  flex: 1;
  height: 76rpx;
  margin-right: 20rpx;
  padding: 0 30rpx;
  border-radius: 38rpx;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 30rpx;
}

.send-btn {
  width: 140rpx !important;
  height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: 38rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
}

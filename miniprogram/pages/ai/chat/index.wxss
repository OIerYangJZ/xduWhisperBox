page {
  background-color: #f5f7fb;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-scroll {
  flex: 1;
  overflow-y: hidden; /* Use scroll-view to handle scrolling */
  padding-bottom: 120rpx;
}

.chat-list {
  padding: 30rpx;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.message-user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #eee;
  flex-shrink: 0;
}

.message-user .avatar {
  margin-left: 20rpx;
}

.message-assistant .avatar {
  margin-right: 20rpx;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx 30rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  line-height: 1.5;
  word-wrap: break-word;
}

.message-user .message-bubble {
  background-color: #0052D9;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.message-assistant .message-bubble {
  background-color: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.02);
}

.typing-indicator {
  display: flex;
  align-items: center;
  height: 40rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #ccc;
  border-radius: 50%;
  margin: 0 6rpx;
  animation: typing 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typing {
  0%, 80%, 100% { 
    transform: scale(0);
  } 
  40% { 
    transform: scale(1);
  }
}

.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.input {
  flex: 1;
  height: 76rpx;
  background-color: #f5f7fb;
  border-radius: 38rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  margin-right: 20rpx;
}

.send-btn {
  width: 140rpx !important;
  height: 76rpx;
  line-height: 76rpx;
  background-color: #0052D9;
  color: #fff;
  font-size: 28rpx;
  border-radius: 38rpx;
  padding: 0;
  margin: 0;
}

.send-btn[disabled] {
  background-color: #a0c4ff !important;
  color: #fff !important;
}

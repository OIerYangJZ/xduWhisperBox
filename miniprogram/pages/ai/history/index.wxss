.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.count {
  color: var(--app-text-secondary);
  font-size: 26rpx;
}

.clear {
  color: var(--app-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.history-card {
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.question {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 650;
}

.answer {
  margin-top: 12rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
  line-height: 1.5;
}

.time {
  margin-top: 14rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
}

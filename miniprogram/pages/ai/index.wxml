<view class="container">
  <view class="header">
    <image class="ai-logo" src="/assets/default-avatar.png" mode="aspectFill"></image>
    <view class="title">XDU AI 助手</view>
    <view class="subtitle">基于校内知识库的智能问答 (RAG)</view>
    
    <button class="new-chat-btn" bindtap="startNewChat">
      <text class="icon">+</text> 发起新对话
    </button>
  </view>

  <view class="history-section">
    <view class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;">
      <view class="section-title" style="margin-bottom: 0;">历史对话</view>
      <view class="more-link" bindtap="goToHistory" style="font-size: 26rpx; color: #0052D9;" wx:if="{{history.length}}">查看全部</view>
    </view>
    <view class="history-list">
      <view class="history-item" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" data-question="{{item.question}}" bindtap="continueChat">
        <view class="item-icon">💬</view>
        <view class="item-content">
          <view class="item-title">{{item.title}}</view>
          <view class="item-date">{{item.date}}</view>
        </view>
        <view class="item-arrow">></view>
      </view>
      <view wx:if="{{!history.length}}" class="empty">暂无历史对话</view>
    </view>
  </view>
</view>

page {
  background-color: #f5f7fb;
}

.container {
  padding: 0;
}

.header {
  background-color: #fff;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.ai-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  margin-bottom: 30rpx;
  background-color: #f0f0f0;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 50rpx;
}

.new-chat-btn {
  background-color: #0052D9;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 0 60rpx;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 82, 217, 0.3);
}

.new-chat-btn .icon {
  font-size: 40rpx;
  margin-right: 12rpx;
  font-weight: normal;
}

.history-section {
  padding: 40rpx 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.history-list {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-item:last-child {
  border-bottom: none;
}

.item-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.item-content {
  flex: 1;
}

.item-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 500rpx;
}

.item-date {
  font-size: 24rpx;
  color: #999;
}

.item-arrow {
  color: #ccc;
  font-size: 30rpx;
}

.college-scroll {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
  white-space: nowrap;
}

.college-row {
  display: flex;
  gap: 14rpx;
  padding: 0 24rpx;
}

.college-chip {
  flex: 0 0 auto;
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 31rpx;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 26rpx;
  line-height: 62rpx;
}

.college-chip.active {
  background: var(--app-primary);
  color: #ffffff;
  font-weight: 600;
}

.college-card {
  margin-top: 0;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.college-name {
  color: var(--app-text-primary);
  font-size: 36rpx;
  font-weight: 700;
}

.college-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.section-title {
  margin: 0;
  padding: 24rpx 24rpx 12rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 700;
}

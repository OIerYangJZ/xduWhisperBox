<view class="page community-page safe-bottom">
  <view class="topbar">
    <view class="search-box">
      <input value="{{keyword}}" placeholder="搜索树洞内容" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onSearchConfirm" />
    </view>
    <view class="post-button" bindtap="goCreatePost">发布</view>
  </view>

  <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view
        wx:for="{{channels}}"
        wx:key="*this"
        class="filter-chip {{activeChannel === item ? 'active' : ''}}"
        data-channel="{{item}}"
        bindtap="onChannelTap"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view class="sort-row">
    <view
      wx:for="{{sortOptions}}"
      wx:key="value"
      class="sort-item {{activeSort === item.value ? 'active' : ''}}"
      data-sort="{{item.value}}"
      bindtap="onSortTap"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{errorText}}" class="empty">{{errorText}}</view>
  <view wx:elif="{{!posts.length}}" class="empty">暂无内容</view>
  <view wx:else>
    <view class="feed-card" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="goPostDetail">
      <view class="feed-avatar">{{item.authorInitial}}</view>
      <view class="feed-body">
        <view class="feed-head">
          <text class="feed-author">{{item.authorAlias}}</text>
          <text class="feed-dot" style="background: {{item.channelColor}}"></text>
          <text class="feed-channel" style="color: {{item.channelColor}}">{{item.channel}}</text>
          <text class="feed-time">{{item.timeText}}</text>
        </view>
        <view class="feed-title">{{item.displayTitle}}</view>
        <view class="feed-summary">{{item.summary}}</view>
        <image wx:if="{{item.firstImageUrl}}" class="post-image" src="{{item.firstImageUrl}}" mode="aspectFill"></image>
        <view class="feed-tags" wx:if="{{item.tags.length}}">
          <text class="feed-tag" wx:for="{{item.tags}}" wx:key="*this">#{{item}}</text>
        </view>
        <view class="feed-actions">
          <view class="{{item.liked ? 'active' : ''}}" data-index="{{index}}" catchtap="toggleLike">♡ {{item.likeCount}}</view>
          <view>☰ {{item.commentCount}}</view>
          <view class="{{item.favorited ? 'active' : ''}}" data-index="{{index}}" catchtap="toggleFavorite">☆ {{item.favoriteCount}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

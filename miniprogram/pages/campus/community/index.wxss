.topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.search-box {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 20rpx;
  background: #fff;
}

.search-box input {
  height: 76rpx;
  color: #1d1d1f;
  font-size: 28rpx;
}

.post-button {
  width: 112rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #155e75;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
}

.filter-scroll {
  padding: 18rpx 0;
  margin-top: 0;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  padding: 0 24rpx;
}

.filter-chip {
  flex: 0 0 auto;
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 29rpx;
  background: #f5f5f7;
  color: #1d1d1f;
  font-size: 26rpx;
  line-height: 58rpx;
}

.filter-chip.active {
  background: #155e75;
  color: #fff;
  font-weight: 600;
}

.sort-row {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  margin: 0;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.sort-item {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f5f5f7;
  color: #8e8e93;
  font-size: 26rpx;
  line-height: 56rpx;
}

.sort-item.active {
  background: rgba(21, 94, 117, .1);
  color: #155e75;
  font-weight: 600;
}

.post-image {
  width: 100%;
  height: 260rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
  background: #e8e8e8;
}

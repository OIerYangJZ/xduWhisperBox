<view class="page create-page safe-bottom">
  <view class="form-section">
    <input class="title-input" placeholder="标题（可选）" maxlength="40" value="{{title}}" bindinput="onTitleInput" />
    <textarea class="content-input" placeholder="写下你想说的话" maxlength="2000" value="{{content}}" bindinput="onContentInput" auto-height />
  </view>

  <view class="form-section">
    <view class="field-row">
      <view class="field-label">频道</view>
      <picker mode="selector" range="{{channels}}" value="{{channelIndex}}" bindchange="onChannelChange">
        <view class="picker-value">{{channels[channelIndex]}}</view>
      </picker>
    </view>
    <view class="field-row">
      <view class="field-label">标签</view>
      <input class="field-input" placeholder="用空格或逗号分隔，最多 5 个" value="{{tagText}}" bindinput="onTagInput" />
    </view>
    <view class="field-row">
      <view>
        <view class="field-label">匿名发布</view>
        <view class="field-desc">前台隐藏真实账号</view>
      </view>
      <switch checked="{{useAnonymousAlias}}" bindchange="onAnonymousChange" color="#155E75" />
    </view>
    <view class="field-row" wx:if="{{useAnonymousAlias}}">
      <view class="field-label">匿名名</view>
      <input class="field-input" placeholder="默认匿名同学" maxlength="16" value="{{anonymousAlias}}" bindinput="onAliasInput" />
    </view>
  </view>

  <button class="primary-button submit" loading="{{submitting}}" bindtap="submitPost">发布</button>
</view>

.create-page {
  padding-top: 24rpx;
}

.form-section {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.title-input {
  height: 74rpx;
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 650;
}

.content-input {
  width: 100%;
  min-height: 300rpx;
  margin-top: 20rpx;
  color: #1d1d1f;
  font-size: 30rpx;
  line-height: 1.6;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.field-row:last-child {
  border-bottom: none;
}

.field-label {
  color: #1d1d1f;
  font-size: 29rpx;
  font-weight: 600;
}

.field-desc {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 24rpx;
}

.picker-value {
  color: #155e75;
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  color: #1d1d1f;
  font-size: 28rpx;
  text-align: right;
}

.image-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.add-image {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: rgba(21, 94, 117, .1);
  color: #155e75;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.image-cell {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 18rpx;
  background: #f5f5f7;
}

.image-cell image {
  width: 100%;
  height: 100%;
}

.image-loading {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 42rpx;
  background: rgba(0, 0, 0, .45);
  color: #fff;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(29, 29, 31, .72);
  color: #fff;
  font-size: 30rpx;
  line-height: 36rpx;
  text-align: center;
}

.submit {
  margin-top: 34rpx;
}

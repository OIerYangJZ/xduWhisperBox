.create-page {
  padding-top: 0;
  background: var(--app-background);
}

.form-section {
  margin: 0;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.title-input {
  height: 74rpx;
  color: var(--app-text-primary);
  font-size: 34rpx;
  font-weight: 650;
}

.content-input {
  width: 100%;
  min-height: 300rpx;
  margin-top: 20rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  line-height: 1.6;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.field-row:last-child {
  border-bottom: none;
}

.field-label {
  color: var(--app-text-primary);
  font-size: 29rpx;
  font-weight: 600;
}

.field-desc {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.picker-value,
.inline-action {
  color: var(--app-primary);
  font-size: 28rpx;
  font-weight: 500;
}

.field-input {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
  text-align: right;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 18rpx 0 8rpx;
}

.image-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.add-image {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.image-cell {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 18rpx;
  background: var(--app-control);
}

.image-cell image {
  width: 100%;
  height: 100%;
}

.image-loading {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 42rpx;
  background: rgba(0, 0, 0, .45);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(29, 29, 31, .72);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 36rpx;
  text-align: center;
}

.submit {
  margin: 34rpx 28rpx 0;
}

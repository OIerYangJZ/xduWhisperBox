<view class="page campus-page {{themeClass}}">
  <view class="home-appbar" wx:if="{{currentTab === 'community'}}">
    <view class="channel-trigger {{showChannelMenu ? 'active' : ''}}" bindtap="toggleChannelMenu" aria-label="切换频道">
      <view class="menu-lines">
        <view></view>
        <view></view>
        <view></view>
      </view>
    </view>

    <view class="toolbar-spacer"></view>

    <view class="icon-button" bindtap="goSearch" aria-label="搜索">
      <view class="search-icon"></view>
    </view>
    <view class="icon-button notify-icon-button" bindtap="goNotifications" aria-label="通知">
      <view class="bell-icon"></view>
      <text wx:if="{{unreadCount}}" class="badge">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
    </view>
  </view>

  <view class="channel-menu-mask" wx:if="{{showChannelMenu && currentTab === 'community'}}" bindtap="closeChannelMenu"></view>
  <view class="channel-menu" wx:if="{{showChannelMenu && currentTab === 'community'}}">
    <view class="channel-menu-section">
      <view class="channel-menu-title">频道</view>
    </view>
    <view
      wx:for="{{channels}}"
      wx:key="*this"
      data-channel="{{item}}"
      class="channel-menu-item {{activeChannel === item ? 'active' : ''}}"
      bindtap="onChannelTap"
    >
      <text>{{item}}</text>
      <text wx:if="{{activeChannel === item}}" class="check-mark">✓</text>
    </view>
    <view class="channel-menu-section">
      <view class="channel-menu-title">排序</view>
    </view>
    <view
      wx:for="{{sortOptions}}"
      wx:key="value"
      data-sort="{{item.value}}"
      class="channel-menu-item {{activeSort === item.value ? 'active' : ''}}"
      bindtap="onSortTap"
    >
      <text>{{item.label}}</text>
      <text wx:if="{{activeSort === item.value}}" class="check-mark">✓</text>
    </view>
    <view class="channel-menu-section">
      <view class="channel-menu-title">入口</view>
    </view>
    <view class="channel-menu-item" data-tab="news" bindtap="switchTab">
      <text>公告</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="channel-menu-item" data-tab="college" bindtap="switchTab">
      <text>学院</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <scroll-view class="feed-list" scroll-y wx:if="{{currentTab === 'community'}}" bindscrolltolower="onReachBottom" bindscroll="onScroll">
    <view class="feed-card" wx:for="{{posts}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <image class="post-avatar" src="{{item.authorAvatarUrl || '/assets/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="feed-body">
        <view class="feed-head">
          <view class="feed-author">{{item.authorAlias || item.authorName || '匿名用户'}}</view>
          <view class="feed-channel">{{item.channel || '综合'}}</view>
          <view class="feed-time">{{item.createdAt}}</view>
        </view>
        <view class="feed-title" wx:if="{{item.title}}">{{item.title}}</view>
        <view class="feed-summary">
          <text>{{item.content}}</text>
        </view>
        <view class="feed-tags" wx:if="{{item.tags && item.tags.length}}">
          <text class="feed-tag" wx:for="{{item.tags}}" wx:key="*this">#{{item}}</text>
        </view>
        <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
          <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" class="post-image"></image>
        </view>
        <view class="feed-actions">
          <text>评论 {{item.commentCount || 0}}</text>
          <text class="{{item.liked || item.isLiked ? 'active' : ''}}">赞 {{item.likeCount || 0}}</text>
          <text wx:if="{{item.statusLabel}}">{{item.statusLabel}}</text>
        </view>
      </view>
    </view>
    <view class="loading-state" wx:if="{{loading}}">加载中...</view>
    <view class="empty-state" wx:if="{{!loading && posts.length === 0}}">暂无内容</view>
    <view class="no-more" wx:if="{{!loading && !hasMore && posts.length > 0}}">没有更多了</view>
  </scroll-view>

  <view class="secondary-page" wx:if="{{currentTab === 'news'}}">
    <view class="sub-header">
      <view>
        <view class="sub-title">校园公告</view>
        <view class="sub-desc">来自校园侧的信息</view>
      </view>
      <view class="tool-button" data-tab="community" bindtap="switchTab">返回</view>
    </view>
    <scroll-view class="news-list" scroll-y>
      <view class="news-card" wx:for="{{news}}" wx:key="id" bindtap="goToNewsDetail" data-title="{{item.title}}" data-content="{{item.content}}" data-created-at="{{item.createdAt}}">
        <view class="news-title">{{item.title}}</view>
        <view class="news-excerpt">{{item.content}}</view>
        <view class="news-footer">
          <text class="news-time">{{item.createdAt}}</text>
          <text class="news-more-link">查看详情</text>
        </view>
      </view>
      <view class="loading-state" wx:if="{{loading}}">加载中...</view>
      <view class="empty-state" wx:if="{{!loading && news.length === 0}}">暂无公告</view>
    </scroll-view>
  </view>

  <view class="secondary-page" wx:if="{{currentTab === 'college'}}">
    <view class="sub-header">
      <view>
        <view class="sub-title">学院</view>
        <view class="sub-desc">按学院查看内容</view>
      </view>
      <view class="tool-button" data-tab="community" bindtap="switchTab">返回</view>
    </view>
    <view class="college-list">
      <view class="college-item" wx:for="{{colleges}}" wx:key="id" bindtap="onCollegeItemTap" data-name="{{item.name}}">
        <view class="college-icon">{{item.icon}}</view>
        <view class="college-name">{{item.name}}</view>
      </view>
      <view class="empty-state" wx:if="{{!loading && colleges.length === 0}}">暂无学院信息</view>
    </view>
  </view>

  <view class="floating-publish {{showPublishButton ? '' : 'hidden'}}" wx:if="{{currentTab === 'community'}}" bindtap="goCreatePost">＋</view>
</view>

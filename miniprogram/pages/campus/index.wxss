.campus-page {
  background: var(--app-background);
}

.community-tools,
.sort-row,
.sub-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.community-tools {
  position: sticky;
  top: 0;
  z-index: 10;
}

.channel-scroll {
  flex: 1;
  white-space: nowrap;
}

.channel-row {
  display: flex;
  gap: 12rpx;
}

.tool-button,
.notify-button,
.secondary-entry {
  position: relative;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 56rpx;
  white-space: nowrap;
}

.sort-spacer {
  flex: 1;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
}

.feed-list,
.news-list {
  height: calc(100vh - 188rpx - env(safe-area-inset-bottom));
  background: var(--app-background);
}

.feed-card {
  padding: 22rpx 24rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-control);
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: var(--app-divider);
}

.floating-publish {
  position: fixed;
  right: 32rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 48rpx;
  line-height: 92rpx;
  text-align: center;
  transition: transform 0.28s ease, opacity 0.28s ease;
  z-index: 20;
}

.floating-publish.hidden {
  transform: translateY(150rpx);
  opacity: 0;
  pointer-events: none;
}

.secondary-page {
  min-height: 100vh;
  background: var(--app-background);
}

.sub-header {
  justify-content: space-between;
  padding-top: 24rpx;
  padding-bottom: 20rpx;
}

.sub-title {
  color: var(--app-text-primary);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.sub-desc {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.news-card {
  padding: 28rpx 32rpx;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.news-title {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.news-excerpt {
  display: -webkit-box;
  margin-top: 10rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 1.5;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.news-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.news-more-link {
  color: var(--app-primary);
}

.college-list {
  background: var(--app-surface);
}

.college-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.college-icon {
  width: 56rpx;
  color: var(--app-primary);
  font-size: 38rpx;
  text-align: center;
}

.college-name {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 500;
}

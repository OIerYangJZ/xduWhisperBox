page {
  background-color: #f5f7fb;
}

.container {
  padding: 0;
}

.tabs {
  display: flex;
  background-color: #fff;
  padding: 0 30rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 32rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #0052D9;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #0052D9;
  border-radius: 4rpx;
}

.feed-list, .news-list {
  height: calc(100vh - 230rpx);
  padding: 20rpx 0;
}

.community-tools,
.sort-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e8e8e8;
}

.channel-scroll {
  flex: 1;
  white-space: nowrap;
}

.channel-row {
  display: flex;
  gap: 12rpx;
}

.channel-chip,
.sort-chip,
.tool-button,
.notify-button,
.publish-button {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: #f5f5f7;
  color: #636366;
  font-size: 25rpx;
  line-height: 56rpx;
  white-space: nowrap;
}

.channel-chip.active,
.sort-chip.active,
.publish-button {
  background: rgba(21, 94, 117, .12);
  color: #155e75;
  font-weight: 600;
}

.notify-button {
  position: relative;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

.sort-row {
  justify-content: flex-start;
}

.publish-button {
  margin-left: auto;
}

.post-card, .news-card {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

/* Post Specific Styles */
.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #eee;
  margin-right: 20rpx;
}

.post-meta {
  flex: 1;
}

.post-author {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.post-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.post-title {
  margin-bottom: 12rpx;
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 750;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
  color: #155e75;
  font-size: 24rpx;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.post-image {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  background-color: #eee;
}

.post-footer {
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.action-item {
  display: flex;
  align-items: center;
  margin-left: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.action-item .icon {
  margin-right: 8rpx;
}

/* News Specific Styles */
.news-tag {
  display: inline-block;
  background-color: rgba(0, 82, 217, 0.1);
  color: #0052D9;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
}

.news-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.news-excerpt {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.news-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
}

.news-time {
  font-size: 24rpx;
  color: #999;
}

.news-more-link {
  font-size: 24rpx;
  color: #0052D9;
}

/* College Grid Styles */
.college-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx 20rpx;
}

.college-item {
  width: 335rpx;
  background-color: #fff;
  margin: 10rpx;
  padding: 40rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.college-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.college-name {
  font-size: 26rpx;
  color: #333;
  text-align: center;
  font-weight: 500;
}

.loading-state, .empty-state, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.placeholder-box {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  color: #999;
  font-size: 32rpx;
}

.floating-publish {
  position: fixed;
  right: 32rpx;
  bottom: 50rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #155e75;
  color: #fff;
  font-size: 48rpx;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(21, 94, 117, .25);
}

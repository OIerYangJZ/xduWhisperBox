.top-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.title {
  color: #1d1d1f;
  font-size: 34rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 10rpx;
  color: #8e8e93;
  font-size: 25rpx;
}

.search {
  width: 104rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(21, 94, 117, .1);
  color: #155e75;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-align: center;
}

.category-row {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx;
  margin: 0;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.category {
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 29rpx;
  background: #f5f5f7;
  color: #1d1d1f;
  font-size: 26rpx;
  line-height: 58rpx;
}

.category.active {
  background: #155e75;
  color: #fff;
  font-weight: 600;
}

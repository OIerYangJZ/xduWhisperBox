.post-detail-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--app-background);
}

.main-scroll {
  flex: 1;
  overflow-y: scroll;
  padding-bottom: 144rpx;
}

.post-card {
  padding: 28rpx 24rpx;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.post-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-control);
}

.post-meta {
  flex: 1;
  min-width: 0;
}

.post-author {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  margin-top: 4rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.post-title {
  margin-bottom: 14rpx;
  color: var(--app-text-primary);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
}

.post-content {
  margin-bottom: 28rpx;
  color: var(--app-text-primary);
  font-size: 34rpx;
  line-height: 1.6;
  word-break: break-word;
}

.post-images {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.post-image {
  width: 100%;
  border-radius: 16rpx;
  background: var(--app-divider);
}

.post-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--app-divider);
}

.action-item,
.small-button,
.share-button {
  display: flex;
  align-items: center;
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 29rpx;
  background: var(--app-control);
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 58rpx;
}

.small-button,
.share-button {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.share-button {
  margin: 0;
}

.action-label {
  margin-right: 8rpx;
}

.active {
  color: var(--app-accent);
  font-weight: 650;
}

.danger {
  color: var(--app-error);
}

.md-heading {
  margin: 16rpx 0;
  font-weight: 800;
}

.md-quote {
  display: block;
  padding-left: 18rpx;
  border-left: 6rpx solid var(--app-primary);
  color: var(--app-text-secondary);
}

.md-list,
.md-p {
  display: block;
  margin: 10rpx 0;
}

.comments-section {
  min-height: 50vh;
  padding: 0 24rpx;
  background: var(--app-surface);
}

.comments-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.section-title {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.comment-sort {
  display: flex;
  gap: 10rpx;
}

.sort-pill {
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: var(--app-control);
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 52rpx;
}

.sort-pill.active {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.comment-item {
  display: flex;
  padding: 20rpx 0 0;
}

.comment-item.target {
  background: var(--app-accent-soft);
}

.comment-avatar {
  width: 70rpx;
  height: 70rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--app-control);
}

.comment-content-box {
  flex: 1;
  min-width: 0;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 10rpx;
}

.comment-author {
  color: var(--app-text-secondary);
  font-size: 28rpx;
  font-weight: 700;
}

.comment-time {
  color: var(--app-text-secondary);
  font-size: 22rpx;
}

.comment-text {
  color: var(--app-text-primary);
  font-size: 30rpx;
  line-height: 1.5;
}

.comment-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
  margin-top: 16rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--app-surface);
  border-top: 1rpx solid var(--app-divider);
}

.reply-pill {
  max-width: 200rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 29rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 24rpx;
  line-height: 58rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comment-input {
  flex: 1;
  height: 76rpx;
  margin-right: 20rpx;
  padding: 0 30rpx;
  border-radius: 38rpx;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 28rpx;
}

.emoji-toggle {
  width: 64rpx;
  height: 64rpx;
  margin: 0 12rpx;
  border-radius: 32rpx;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 34rpx;
  line-height: 64rpx;
  text-align: center;
}

.emoji-panel {
  position: fixed;
  right: 0;
  bottom: 120rpx;
  left: 0;
  z-index: 19;
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 24rpx 30rpx;
  background: var(--app-surface);
  border-top: 1rpx solid var(--app-divider);
  font-size: 42rpx;
}

.send-btn {
  width: 140rpx !important;
  height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: 38rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 76rpx;
}

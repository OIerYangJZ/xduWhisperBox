.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.search-row input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 20rpx;
  background: #fff;
  color: #1d1d1f;
  font-size: 28rpx;
}

.search-button {
  width: 112rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #155e75;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
}

.type-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e8e8e8;
}

.type-chip {
  flex: 1;
  height: 64rpx;
  border-radius: 18rpx;
  background: #f5f5f7;
  color: #636366;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
}

.type-chip.active {
  background: #155e75;
  color: #fff;
  font-weight: 600;
}

.filter-scroll {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  padding: 0 24rpx;
}

.filter-chip {
  flex: 0 0 auto;
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 29rpx;
  background: #f5f5f7;
  color: #1d1d1f;
  font-size: 25rpx;
  line-height: 58rpx;
}

.filter-chip.active {
  background: #155e75;
  color: #fff;
  font-weight: 600;
}

.sort-row {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.sort-chip {
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 52rpx;
}

.sort-chip.active {
  background: rgba(21, 94, 117, .1);
  color: #155e75;
  font-weight: 600;
}

.history {
  padding: 24rpx;
  margin-top: 0;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #1d1d1f;
  font-size: 31rpx;
  font-weight: 700;
}

.clear {
  color: #8e8e93;
  font-size: 26rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.history-tag {
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  background: #f5f5f7;
  color: #1d1d1f;
  font-size: 26rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.user-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #f5f5f7;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.user-name {
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
}

.user-bio {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 25rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-action {
  color: #155e75;
  font-size: 26rpx;
}

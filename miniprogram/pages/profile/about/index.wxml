<view class="page about-page mobile-list-page {{themeClass}}">
  <view class="brand-card">
    <view class="brand-logo">☀</view>
    <view class="brand-title">See电</view>
    <view class="brand-subtitle">西电校内匿名社区</view>
    <view class="version">Version {{version}}</view>
  </view>

  <view class="mobile-tile-card">
    <view class="mobile-tile" bindtap="checkUpdate">
      <text class="mobile-tile-icon">↓</text>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">检查更新</view>
        <view class="mobile-tile-subtitle">当前版本 {{version}}</view>
      </view>
      <text class="mobile-tile-arrow">›</text>
    </view>
  </view>

  <view class="mobile-tile-card">
    <view class="mobile-tile" wx:for="{{items}}" wx:key="type" data-type="{{item.type}}" bindtap="openLegal">
      <text class="mobile-tile-icon">{{item.icon}}</text>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">{{item.label}}</view>
        <view class="mobile-tile-subtitle">{{item.subtitle}}</view>
      </view>
      <text class="mobile-tile-arrow">›</text>
    </view>
  </view>

  <view class="mobile-tile-card">
    <view class="mobile-tile" bindtap="openFeedback">
      <text class="mobile-tile-icon">?</text>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">帮助与反馈</view>
        <view class="mobile-tile-subtitle">问题反馈、联系方式与常见问题</view>
      </view>
      <text class="mobile-tile-arrow">›</text>
    </view>
    <view class="mobile-tile" data-type="acknowledgements" bindtap="openLegal">
      <text class="mobile-tile-icon">♡</text>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">致谢页</view>
        <view class="mobile-tile-subtitle">感谢每一位参与建设与反馈的同学</view>
      </view>
      <text class="mobile-tile-arrow">›</text>
    </view>
  </view>

  <view class="copyright">© 2026 XDU Whisper Box</view>
</view>

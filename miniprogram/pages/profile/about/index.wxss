.about-page {
  padding: 24rpx;
}

.brand-card,
.section {
  border-radius: 16rpx;
  background: var(--app-surface);
  overflow: hidden;
}

.brand-card {
  padding: 34rpx 28rpx;
  margin-bottom: 24rpx;
}

.brand-title {
  color: var(--app-text-primary);
  font-size: 40rpx;
  font-weight: 800;
}

.brand-subtitle,
.version {
  margin-top: 12rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 29rpx;
}

.row:last-child {
  border-bottom: none;
}

.row text:last-child {
  color: var(--app-text-secondary);
}

<view class="page security-page mobile-list-page {{themeClass}}">
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:else>
    <view class="mobile-tile-card">
      <view class="mobile-tile" bindtap="goResetPassword">
        <text class="mobile-tile-icon">⌕</text>
        <view class="mobile-tile-body">
          <view class="mobile-tile-title">修改密码</view>
          <view class="mobile-tile-subtitle">定期修改密码有助于账号安全</view>
        </view>
        <text class="mobile-tile-arrow">›</text>
      </view>
      <view wx:if="{{!profile.isLevelOneUser}}" class="mobile-tile" bindtap="requestLevelUpgrade">
        <text class="mobile-tile-icon">◇</text>
        <view class="mobile-tile-body">
          <view class="mobile-tile-title">申请成为一级用户</view>
          <view class="mobile-tile-subtitle">{{levelUpgradeSubtitle}}</view>
        </view>
        <text class="mobile-tile-arrow">›</text>
      </view>
    </view>

    <view class="mobile-tile-card danger-card">
      <view class="mobile-tile" bindtap="requestCancellation">
        <text class="mobile-tile-icon">⊘</text>
        <view class="mobile-tile-body">
          <view class="mobile-tile-title danger-title">注销账号</view>
          <view class="mobile-tile-subtitle">{{cancellationSubtitle}}</view>
        </view>
        <text class="mobile-tile-arrow">›</text>
      </view>
    </view>
  </view>
</view>

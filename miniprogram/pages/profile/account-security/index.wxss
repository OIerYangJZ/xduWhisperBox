.page {
  padding: 24rpx;
  background: #f5f5f7;
  min-height: 100vh;
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: #8e8e93;
  font-size: 28rpx;
}

.section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #fff;
}

.section-title {
  margin-bottom: 12rpx;
  color: #1d1d1f;
  font-size: 31rpx;
  font-weight: 700;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  border-bottom: 1rpx solid #e8e8e8;
  color: #1d1d1f;
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row text:last-child {
  color: #8e8e93;
}

.nav-row {
  color: #1d1d1f;
}

.safe-button,
.danger-outline-button {
  height: 76rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.safe-button {
  background: #155e75;
  color: #fff;
}

.danger-outline-button {
  border: 1rpx solid #ff3b30;
  background: #fff;
  color: #ff3b30;
}

.safe-button[disabled],
.danger-outline-button[disabled] {
  opacity: .45;
}
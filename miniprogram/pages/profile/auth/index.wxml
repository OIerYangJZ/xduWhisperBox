<view class="container {{themeClass}}">
  <view class="title">登录 XDU WhisperBox</view>
  <view class="subtitle">默认使用学号和密码登录</view>

  <view class="form-group">
    <input class="input" placeholder="学号" value="{{identifier}}" bindinput="onIdentifierInput" />
  </view>
  <view class="form-group">
    <input class="input" type="password" placeholder="密码" value="{{password}}" bindinput="onPasswordInput" />
  </view>

  <button class="btn-primary" bindtap="handleLogin">登录</button>
  <view class="actions">
    <text class="link" bindtap="handleEmailCodeLogin">邮箱验证码登录/注册</text>
    <text class="link" bindtap="handleResetPassword">忘记密码</text>
  </view>
</view>

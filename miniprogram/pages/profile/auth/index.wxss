.container {
  padding: 60rpx 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1d1d1f;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8e8e93;
  margin-bottom: 60rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.input {
  height: 90rpx;
  background-color: #f5f5f7;
  border-radius: 20rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
}

.btn-primary {
  background-color: #155e75;
  color: #fff;
  border-radius: 20rpx;
  margin-top: 60rpx;
  font-size: 32rpx;
}

.actions {
  display: flex;
  justify-content: center;
  gap: 36rpx;
  margin-top: 40rpx;
}

.link {
  font-size: 28rpx;
  color: #155e75;
}

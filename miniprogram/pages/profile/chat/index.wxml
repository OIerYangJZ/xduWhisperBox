<view class="chat-page">
  <view class="message-list">
    <view wx:if="{{loading}}" class="empty">加载中...</view>
    <view wx:elif="{{!messages.length}}" class="empty">暂无消息</view>
    <view wx:else>
      <view class="message-row {{item.fromMe ? 'mine' : ''}}" wx:for="{{messages}}" wx:key="id">
        <view class="bubble">
          <view class="reply" wx:if="{{item.replyToContent}}">{{item.replyToSender}}：{{item.replyToContent}}</view>
          <view>{{item.content}}</view>
          <view class="time">{{item.timeText || item.createdAt}}</view>
        </view>
      </view>
    </view>
  </view>
  <view class="chat-actions">
    <button class="block-button" bindtap="toggleBlock">{{blockedByMe ? '解除屏蔽' : '屏蔽'}}</button>
    <input class="chat-input" value="{{content}}" bindinput="onInput" confirm-type="send" bindconfirm="sendMessage" placeholder="输入消息" />
    <button class="send-button" loading="{{sending}}" bindtap="sendMessage">发送</button>
  </view>
</view>

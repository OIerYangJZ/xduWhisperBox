.chat-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: #f5f7fb;
}

.message-list {
  padding: 24rpx;
}

.message-row {
  display: flex;
  margin-bottom: 20rpx;
}

.message-row.mine {
  justify-content: flex-end;
}

.bubble {
  max-width: 560rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #1d1d1f;
  font-size: 28rpx;
  line-height: 1.5;
}

.mine .bubble {
  background: #155e75;
  color: #fff;
}

.reply {
  margin-bottom: 10rpx;
  color: #8e8e93;
  font-size: 24rpx;
}

.time {
  margin-top: 8rpx;
  opacity: .7;
  font-size: 22rpx;
}

.chat-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
}

.reply-pill {
  max-width: 180rpx;
  height: 58rpx;
  padding: 0 14rpx;
  border-radius: 29rpx;
  background: rgba(21, 94, 117, .1);
  color: #155e75;
  font-size: 22rpx;
  line-height: 58rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.block-button,
.send-button {
  width: 104rpx;
  height: 70rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 70rpx;
}

.block-button {
  background: #f5f5f7;
  color: #8e8e93;
}

.send-button {
  background: #155e75;
  color: #fff;
}

.chat-input {
  flex: 1;
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #f5f7fb;
  font-size: 28rpx;
}

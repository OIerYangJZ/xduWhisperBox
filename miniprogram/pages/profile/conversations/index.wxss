.conversations-page {
  background: var(--app-background);
}

.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 28rpx 24rpx 16rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.page-title {
  color: var(--app-text-primary);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-subtitle {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

.conversation-list {
  background: var(--app-surface);
}

.conversation-shell {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.conversation-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--app-error);
}

.delete-button {
  padding: 0;
  background: transparent;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1;
}

.conversation-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  background: var(--app-surface);
  transition: transform 0.18s ease;
}

.avatar {
  width: 86rpx;
  height: 86rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-control);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  background: rgba(21, 94, 117, .12);
}

.conversation-body {
  flex: 1;
  min-width: 0;
}

.conversation-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.name {
  max-width: 330rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-unread {
  font-weight: 800;
}

.blocked-tag {
  flex: 0 0 auto;
  padding: 0 8rpx;
  border-radius: 4rpx;
  background: var(--app-control);
  color: var(--app-text-secondary);
  font-size: 20rpx;
  line-height: 28rpx;
}

.time,
.message {
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.message {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

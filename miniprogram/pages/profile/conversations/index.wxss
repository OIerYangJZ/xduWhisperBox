.conversations-page {
  background: #fff;
}

.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 28rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.page-title {
  color: #1d1d1f;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-subtitle {
  margin-top: 6rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.4;
}

.header-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: rgba(21, 94, 117, .1);
  color: #155e75;
  font-size: 24rpx;
  font-weight: 600;
}

.header-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.conversation-list {
  background: #fff;
}

.conversation-shell {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.conversation-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff3b30;
}

.delete-button {
  padding: 0;
  background: transparent;
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
}

.conversation-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  background: #fff;
  transition: transform 0.18s ease;
}

.avatar {
  width: 86rpx;
  height: 86rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #f5f5f7;
}

.conversation-body {
  flex: 1;
  min-width: 0;
}

.conversation-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.name {
  max-width: 330rpx;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-unread {
  font-weight: 800;
}

.blocked-tag {
  flex: 0 0 auto;
  padding: 0 8rpx;
  border-radius: 4rpx;
  background: rgba(142, 142, 147, .18);
  color: #8e8e93;
  font-size: 20rpx;
  line-height: 28rpx;
}

.time,
.message {
  color: #8e8e93;
  font-size: 24rpx;
}

.message {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.theme-dark.conversations-page,
.theme-dark .page-header,
.theme-dark .conversation-list,
.theme-dark .conversation-shell,
.theme-dark .conversation-row {
  background: #1c1c1e !important;
  border-color: #3a3a3c !important;
}

.theme-dark .page-title,
.theme-dark .name {
  color: #f5f5f7 !important;
}

.theme-dark .page-subtitle,
.theme-dark .time,
.theme-dark .message {
  color: #8e8e93 !important;
}

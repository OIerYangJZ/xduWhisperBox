<view class="page display-page {{themeClass}}">
  <view class="section">
    <view class="section-title">{{t.theme || '主题'}}</view>
    <view
      wx:for="{{themeOptions}}"
      wx:key="value"
      class="option-row {{currentThemeOption === item.value ? 'active' : ''}}"
      data-theme="{{item.value}}"
      bindtap="onThemeTap"
    >
      <text>{{item.label}}</text>
      <text wx:if="{{currentThemeOption === item.value}}">✓</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">{{t.language || '语言'}}</view>
    <view
      wx:for="{{langOptions}}"
      wx:key="value"
      class="option-row {{currentLanguage === item.value ? 'active' : ''}}"
      data-lang="{{item.value}}"
      bindtap="onLangTap"
    >
      <text>{{item.label}}</text>
      <text wx:if="{{currentLanguage === item.value}}">✓</text>
    </view>
  </view>
</view>

<view class="page display-page mobile-list-page {{themeClass}}">
  <view class="mobile-tile-card">
    <view
      wx:for="{{themeOptions}}"
      wx:key="value"
      class="mobile-tile option-row {{currentThemeOption === item.value ? 'active' : ''}}"
      data-theme="{{item.value}}"
      bindtap="onThemeTap"
    >
      <text class="mobile-tile-icon">◐</text>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">{{item.label}}</view>
        <view class="mobile-tile-subtitle">外观主题</view>
      </view>
      <text wx:if="{{currentThemeOption === item.value}}" class="check-mark">✓</text>
    </view>
  </view>

  <view class="mobile-tile-card">
    <view
      wx:for="{{langOptions}}"
      wx:key="value"
      class="mobile-tile option-row {{currentLanguage === item.value ? 'active' : ''}}"
      data-lang="{{item.value}}"
      bindtap="onLangTap"
    >
      <text class="mobile-tile-icon">◎</text>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">{{item.label}}</view>
        <view class="mobile-tile-subtitle">多语言</view>
      </view>
      <text wx:if="{{currentLanguage === item.value}}" class="check-mark">✓</text>
    </view>
  </view>
</view>

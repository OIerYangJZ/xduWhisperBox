.section {
  margin: 24rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: var(--app-surface);
}

.section-title {
  padding: 24rpx;
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 700;
  border-bottom: 1rpx solid var(--app-divider);
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 29rpx;
}

.option-row:last-child {
  border-bottom: none;
}

.option-row.active {
  color: var(--app-primary);
  font-weight: 600;
}

.section {
  margin: 24rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff;
}

.section-title {
  padding: 24rpx;
  color: #1d1d1f;
  font-size: 31rpx;
  font-weight: 700;
  border-bottom: 1rpx solid #e8e8e8;
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
  color: #1d1d1f;
  font-size: 29rpx;
}

.option-row:last-child {
  border-bottom: none;
}

.option-row.active {
  color: #155e75;
  font-weight: 600;
}

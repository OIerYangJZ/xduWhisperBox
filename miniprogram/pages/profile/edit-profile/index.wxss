.page {
  padding: 24rpx;
  background: #f5f5f7;
  min-height: 100vh;
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: #8e8e93;
  font-size: 28rpx;
}

.section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #fff;
}

.section-title {
  margin-bottom: 12rpx;
  color: #1d1d1f;
  font-size: 31rpx;
  font-weight: 700;
}

.avatar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  border-bottom: 1rpx solid #e8e8e8;
  padding: 16rpx 0;
}

.avatar-preview {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: #f5f5f7;
}

.avatar-button {
  height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 29rpx;
  background: rgba(21, 94, 117, .1);
  color: #155e75;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 58rpx;
}

.background-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 150rpx;
  padding: 16rpx 0;
}

.background-preview,
.background-empty {
  flex: 1;
  height: 112rpx;
  border-radius: 14rpx;
  background: #f5f5f7;
  overflow: hidden;
}

.background-empty {
  color: #8e8e93;
  font-size: 26rpx;
  line-height: 112rpx;
  text-align: center;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  border-bottom: 1rpx solid #e8e8e8;
  color: #1d1d1f;
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row text:last-child {
  max-width: 430rpx;
  color: #8e8e93;
  text-align: right;
  word-break: break-all;
}

.row-input {
  width: 430rpx;
  min-height: 64rpx;
  color: #1d1d1f;
  font-size: 28rpx;
  text-align: right;
}

.picker-value {
  min-width: 160rpx;
  color: #8e8e93;
  font-size: 28rpx;
  text-align: right;
}

.bio-field {
  padding: 22rpx 0;
}

.bio-label {
  color: #1d1d1f;
  font-size: 28rpx;
}

.bio-input {
  width: 100%;
  height: 140rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  background: #fcfcfd;
  color: #1d1d1f;
  font-size: 27rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.save-button {
  height: 86rpx;
  margin-top: 40rpx;
  border-radius: 12rpx;
  background: #155e75;
  color: #fff;
  font-size: 30rpx;
  line-height: 86rpx;
}
.page {
  min-height: 100vh;
  padding: 24rpx;
  background: var(--app-background);
  box-sizing: border-box;
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.section {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: var(--app-surface);
  border: 1rpx solid var(--app-divider);
  border-radius: 16rpx;
}

.section-title {
  margin-bottom: 20rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.avatar-panel {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-preview {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--app-control);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-primary);
  font-size: 48rpx;
  font-weight: 600;
}

.avatar-preview image {
  width: 100%;
  height: 100%;
}

.panel-actions {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.avatar-button {
  margin: 0;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  background: rgba(21, 94, 117, 0.12);
  color: var(--app-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.avatar-button.ghost {
  background: transparent;
  border: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
}

.background-preview-wrap {
  margin-top: 20rpx;
}

.background-preview {
  height: 240rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 16rpx;
  background: var(--app-control);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-text-secondary);
  font-size: 26rpx;
}

.background-preview image {
  width: 100%;
  height: 100%;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row text:last-child {
  max-width: 430rpx;
  color: var(--app-text-secondary);
  text-align: right;
  word-break: break-all;
}

.row-input {
  width: 430rpx;
  min-height: 64rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
  text-align: right;
}

.picker-value {
  min-width: 160rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  text-align: right;
}

.bio-field {
  padding: 22rpx 0 0;
}

.bio-label {
  color: var(--app-text-primary);
  font-size: 28rpx;
}

.bio-input {
  width: 100%;
  height: 160rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 16rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 27rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.save-button {
  height: 96rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 96rpx;
}

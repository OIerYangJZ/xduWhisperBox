.form-panel {
  padding: 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.content-input {
  width: 100%;
  min-height: 280rpx;
  color: var(--app-text-primary);
  font-size: 29rpx;
  line-height: 1.6;
}

.contact-input {
  height: 82rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 28rpx;
}

.submit {
  margin-top: 28rpx;
}

.feedback-page {
  padding: 32rpx;
  background: var(--app-background);
}

.form-panel {
  padding: 32rpx;
  border: 1rpx solid rgba(232, 232, 232, .5);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.content-input {
  width: 100%;
  min-height: 280rpx;
  color: var(--app-text-primary);
  font-size: 29rpx;
  line-height: 1.6;
  border-radius: 16rpx;
}

.contact-input {
  height: 82rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 28rpx;
}

.submit {
  margin-top: 32rpx;
  height: 100rpx;
  border-radius: 24rpx;
  line-height: 100rpx;
}

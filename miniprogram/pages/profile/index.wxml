<view class="container">
  <view class="profile-cover"></view>
  <view class="profile-head">
    <image class="avatar" src="{{userInfo ? (userInfo.avatarUrl || '/assets/default-avatar.png') : '/assets/default-avatar.png'}}" mode="aspectFill"></image>
    <view class="edit-pill" bindtap="goToSettings">设置</view>
  </view>
  <view class="profile-info">
    <view class="user-info" wx:if="{{isLoggedIn}}">
      <view class="nickname">{{userInfo.nickname || '西电同学'}}</view>
      <view class="student-id" wx:if="{{userInfo.studentId}}">@{{userInfo.studentId}}</view>
      <view class="student-id" wx:else>@未绑定学号</view>
      <view class="bio">{{userInfo.bio || '匿名交流，理性表达。'}}</view>
    </view>
    <view class="login-prompt" wx:else bindtap="goToLogin">
      <view class="login-title">点击登录/注册</view>
      <view class="login-desc">登录后体验完整功能</view>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goToMyPosts">
      <text class="menu-text">我的发布</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToMyComments">
      <text class="menu-text">我的评论</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToMyReports">
      <text class="menu-text">我的举报</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToFavorites">
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToConversations">
      <text class="menu-text">私信</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" data-type="friends" bindtap="goToSocialList">
      <text class="menu-text">好友</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" data-type="following" bindtap="goToSocialList">
      <text class="menu-text">关注</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" data-type="followers" bindtap="goToSocialList">
      <text class="menu-text">粉丝</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToNotifications">
      <text class="menu-text">通知中心</text>
      <view class="menu-right">
        <text wx:if="{{unreadCount}}" class="badge">{{unreadCount}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
    <view class="menu-item" bindtap="goToFeedback">
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-text">设置</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" data-type="user-agreement" bindtap="goToLegal">
      <text class="menu-text">用户协议</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" data-type="privacy-policy" bindtap="goToLegal">
      <text class="menu-text">隐私政策</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" data-type="community-guidelines" bindtap="goToLegal">
      <text class="menu-text">社区规范/举报说明</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" data-type="acknowledgements" bindtap="goToLegal">
      <text class="menu-text">致谢</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>

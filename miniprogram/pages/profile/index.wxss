page {
  background: var(--app-background);
}

.container {
  padding: 0;
  background: var(--app-background);
}

.profile-cover {
  height: 188rpx;
  background: var(--app-primary-soft);
}

.profile-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: var(--app-surface);
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  margin-top: -56rpx;
  border: 8rpx solid var(--app-surface);
  border-radius: 50%;
  background: var(--app-control);
}

.edit-pill {
  height: 56rpx;
  margin-top: -22rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 28rpx;
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.profile-info {
  padding: 12rpx 32rpx 28rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.nickname,
.login-title {
  margin-bottom: 10rpx;
  color: var(--app-text-primary);
  font-size: 36rpx;
  font-weight: 700;
}

.student-id,
.login-desc {
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.bio {
  margin-top: 20rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 1.5;
}

.login-prompt {
  flex: 1;
}

.menu-list {
  background: var(--app-surface);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

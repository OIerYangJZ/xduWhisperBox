.legal-page {
  padding: 32rpx 32rpx 80rpx;
}

.legal-title {
  margin-bottom: 24rpx;
  color: var(--app-text-primary);
  font-size: 40rpx;
  font-weight: 700;
}

.section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--app-divider);
}

.section-heading {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.section-body {
  margin-top: 14rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 1.65;
}

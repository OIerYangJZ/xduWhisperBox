.legal-page {
  padding: 34rpx 30rpx 80rpx;
}

.legal-title {
  margin-bottom: 28rpx;
  color: var(--app-text-primary);
  font-size: 42rpx;
  font-weight: 800;
}

.section {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--app-divider);
}

.section-heading {
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 700;
}

.section-body {
  margin-top: 14rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 1.7;
}

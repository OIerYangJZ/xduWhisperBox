<view class="page {{themeClass}}">
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{!requests.length}}" class="empty">暂无私信请求</view>
  <view wx:else>
    <view class="request-row" wx:for="{{requests}}" wx:key="id">
      <view class="request-body">
        <view class="request-title">{{item.fromUserName || item.fromAlias || '同学'}}</view>
        <view class="request-text">{{item.reason || item.message || '申请私信'}}</view>
        <view class="request-time">{{item.timeText || item.createdAt}}</view>
      </view>
      <button class="request-button" data-id="{{item.id}}" data-accept="1" bindtap="handleRequest">接受</button>
      <button class="request-button reject" data-id="{{item.id}}" data-accept="0" bindtap="handleRequest">拒绝</button>
    </view>
  </view>
</view>

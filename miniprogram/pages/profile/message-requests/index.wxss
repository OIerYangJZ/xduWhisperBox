.request-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.request-body {
  flex: 1;
  min-width: 0;
}

.request-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.request-text,
.request-time {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.request-button {
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 29rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 58rpx;
}

.request-button.reject {
  background: var(--app-control);
  color: var(--app-error);
}

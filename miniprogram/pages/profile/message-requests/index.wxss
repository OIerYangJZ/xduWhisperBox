.request-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.request-body {
  flex: 1;
  min-width: 0;
}

.request-title {
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
}

.request-text,
.request-time {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 24rpx;
}

.request-button {
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 29rpx;
  background: #155e75;
  color: #fff;
  font-size: 24rpx;
  line-height: 58rpx;
}

.request-button.reject {
  background: #f5f5f7;
  color: #ff3b30;
}

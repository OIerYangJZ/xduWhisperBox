.comment-card {
  padding: 28rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.comment-post {
  color: var(--app-primary);
  font-size: 27rpx;
  font-weight: 650;
}

.comment-content {
  margin-top: 12rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  line-height: 1.55;
}

.comment-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
}

.danger {
  color: var(--app-error);
}

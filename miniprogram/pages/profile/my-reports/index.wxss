.report-card {
  padding: 28rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.report-head {
  display: flex;
  justify-content: space-between;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.status {
  color: var(--app-primary);
  font-size: 25rpx;
  font-weight: 650;
}

.report-target,
.report-desc,
.report-result,
.report-time {
  margin-top: 12rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.report-result {
  color: var(--app-text-primary);
}

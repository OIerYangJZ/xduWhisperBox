.report-card {
  padding: 28rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.report-head {
  display: flex;
  justify-content: space-between;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 700;
}

.status {
  color: #155e75;
  font-size: 25rpx;
  font-weight: 650;
}

.report-target,
.report-desc,
.report-result,
.report-time {
  margin-top: 12rpx;
  color: #8e8e93;
  font-size: 26rpx;
  line-height: 1.5;
}

.report-result {
  color: #1d1d1f;
}

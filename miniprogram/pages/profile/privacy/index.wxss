.page {
  padding: 24rpx;
  background: var(--app-control);
  min-height: 100vh;
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: var(--app-surface);
}

.section-title {
  margin-bottom: 12rpx;
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 700;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  border-bottom: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 28rpx;
}

.switch-row:last-child {
  border-bottom: none;
}
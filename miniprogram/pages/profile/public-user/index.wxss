.public-page {
  padding: 42rpx 30rpx;
}

.profile-head {
  position: relative;
  overflow: hidden;
  border-radius: 18rpx;
  padding: 34rpx 24rpx;
  background: var(--app-surface);
  text-align: center;
}

.cover {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  width: 100%;
  height: 180rpx;
  opacity: .32;
}

.avatar {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: var(--app-control);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-primary);
  font-size: 48rpx;
  font-weight: 700;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar.fallback {
  background: rgba(21, 94, 117, .12);
}

.name {
  margin-top: 20rpx;
  color: var(--app-text-primary);
  font-size: 38rpx;
  font-weight: 800;
}

.bio {
  margin-top: 12rpx;
  color: var(--app-text-secondary);
  font-size: 27rpx;
  line-height: 1.5;
}

.stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 24rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
}

.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 42rpx;
}

.primary,
.secondary {
  flex: 1;
  height: 78rpx;
  border-radius: 12rpx;
  font-size: 29rpx;
  line-height: 78rpx;
}

.primary {
  background: var(--app-primary);
  color: #ffffff;
}

.secondary {
  background: rgba(21, 94, 117, .1);
  color: var(--app-primary);
}

.post-section {
  margin-top: 34rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 750;
}

.post-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
  border-radius: 16rpx;
  background: var(--app-surface);
}

.post-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.post-summary {
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.5;
}

.post-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 16rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
}

.empty-small {
  padding: 34rpx 0;
  color: var(--app-text-secondary);
  font-size: 27rpx;
  text-align: center;
}

.public-page {
  padding: 42rpx 30rpx;
}

.profile-head {
  text-align: center;
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: #f5f5f7;
}

.name {
  margin-top: 20rpx;
  color: #1d1d1f;
  font-size: 38rpx;
  font-weight: 800;
}

.bio {
  margin-top: 12rpx;
  color: #8e8e93;
  font-size: 27rpx;
  line-height: 1.5;
}

.stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 24rpx;
  color: #4a4a4f;
  font-size: 27rpx;
}

.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 42rpx;
}

.primary,
.secondary {
  flex: 1;
  height: 78rpx;
  border-radius: 12rpx;
  font-size: 29rpx;
  line-height: 78rpx;
}

.primary {
  background: #155e75;
  color: #fff;
}

.secondary {
  background: rgba(21, 94, 117, .1);
  color: #155e75;
}

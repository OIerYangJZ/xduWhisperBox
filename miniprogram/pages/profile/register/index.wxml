<view class="page register-page safe-bottom {{themeClass}}">
  <view class="page-head">
    <view class="title">邮箱验证码登录/注册</view>
    <view class="subtitle">未注册用户验证后自动注册</view>
  </view>

  <view class="form-panel">
    <view class="student-id-field">
      <input class="student-id-input" placeholder="学号" maxlength="20" value="{{studentId}}" bindinput="onStudentIdInput" />
      <text class="email-suffix">{{emailSuffix}}</text>
    </view>
    <input class="input" placeholder="6 位验证码" maxlength="6" value="{{code}}" bindinput="onCodeInput" />
    <view class="debug-code" wx:if="{{debugCode}}">内测验证码：{{debugCode}}</view>
    <button class="secondary-button" loading="{{sendingCode}}" bindtap="submitSendCode">{{codeSent ? '重新发送验证码' : '发送验证码'}}</button>
    <button class="primary-button" loading="{{verifying}}" bindtap="submitVerify">完成验证</button>
  </view>
</view>

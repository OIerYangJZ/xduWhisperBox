<view class="page register-page safe-bottom">
  <view class="form-panel">
    <input class="input" placeholder="昵称" maxlength="16" value="{{nickname}}" bindinput="onNicknameInput" />
    <input class="input" placeholder="西电学生邮箱" value="{{email}}" bindinput="onEmailInput" />
    <input class="input" type="password" placeholder="密码（至少 6 位）" value="{{password}}" bindinput="onPasswordInput" />
    <button class="primary-button" loading="{{sending}}" bindtap="submitRegister">发送验证码</button>
  </view>

  <view class="form-panel verify-panel" wx:if="{{needVerify}}">
    <input class="input" placeholder="6 位验证码" maxlength="6" value="{{code}}" bindinput="onCodeInput" />
    <view class="debug-code" wx:if="{{debugCode}}">内测验证码：{{debugCode}}</view>
    <button class="primary-button" loading="{{verifying}}" bindtap="submitVerify">完成验证</button>
  </view>
</view>

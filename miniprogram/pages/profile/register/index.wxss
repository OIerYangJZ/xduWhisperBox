.form-panel {
  padding: 28rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.verify-panel {
  margin-top: 22rpx;
}

.input {
  height: 84rpx;
  margin-bottom: 22rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 29rpx;
}

.debug-code {
  margin: 0 0 22rpx;
  color: var(--app-accent);
  font-size: 26rpx;
}

.report-page {
  padding: 24rpx;
}

.section {
  margin-bottom: 22rpx;
  border-radius: 16rpx;
  background: var(--app-surface);
  overflow: hidden;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 28rpx;
  align-items: center;
}

.row:last-child {
  border-bottom: none;
}

.row text:last-child {
  color: var(--app-text-secondary);
  text-align: right;
}

.block-title {
  padding: 24rpx 24rpx 8rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.block-text {
  padding: 0 24rpx 24rpx;
  color: var(--app-text-secondary);
  font-size: 27rpx;
  line-height: 1.6;
}

.primary-button {
  height: 82rpx;
  border-radius: 14rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 29rpx;
  line-height: 82rpx;
}

.container {
  padding: 60rpx 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--app-text-secondary);
  margin-bottom: 60rpx;
}

.form-group {
  margin-bottom: 36rpx;
}

.input {
  height: 90rpx;
  background-color: var(--app-control);
  border-radius: 20rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.code-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.code-input {
  flex: 1;
}

.code-button {
  width: 180rpx;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 20rpx;
  color: var(--app-primary);
  background: var(--app-primary-soft);
  font-size: 28rpx;
}

.btn-primary {
  background-color: var(--app-primary);
  color: #ffffff;
  border-radius: 20rpx;
  margin-top: 40rpx;
  font-size: 32rpx;
}

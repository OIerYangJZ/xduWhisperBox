<view class="page settings-list-page">
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:else>
    <view class="section">
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/edit-profile/index">
        <text class="menu-title">个人资料</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/privacy/index">
        <text class="menu-title">隐私与通知</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/account-security/index">
        <text class="menu-title">账号与安全</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="section">
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/display-settings/index">
        <text class="menu-title">显示设置</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/about/index">
        <text class="menu-title">关于与更新</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/feedback/index">
        <text class="menu-title">帮助与反馈</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/legal/index?type=user-agreement">
        <text class="menu-title">用户协议</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <button class="logout-button" loading="{{loggingOut}}" bindtap="handleLogout">退出登录</button>
  </view>
</view>
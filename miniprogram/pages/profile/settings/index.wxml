<view class="page settings-list-page {{themeClass}}">
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:else>
    <view class="section">
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/edit-profile/index">
        <text class="menu-title">{{t.personal_info || '个人资料'}}</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/privacy/index">
        <text class="menu-title">{{t.privacy_settings || '隐私与通知'}}</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/account-security/index">
        <text class="menu-title">{{t.security_settings || '账号与安全'}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="section">
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/display-settings/index">
        <text class="menu-title">{{t.display_settings || '显示设置'}}</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/ai-settings/index">
        <text class="menu-title">AI 接口与知识库</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/about/index">
        <text class="menu-title">{{t.about || '关于与更新'}}</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/feedback/index">
        <text class="menu-title">{{t.help_feedback || '帮助与反馈'}}</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/profile/legal/index?type=user-agreement">
        <text class="menu-title">{{t.user_agreement || '用户协议'}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <button class="logout-button" loading="{{loggingOut}}" bindtap="handleLogout">{{t.logout || '退出登录'}}</button>
  </view>
</view>

.settings-list-page {
  padding: 0;
  background: var(--app-background);
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.section {
  margin: 0;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
  overflow: hidden;
}

.section + .section {
  margin-top: 18rpx;
  border-top: 1rpx solid var(--app-divider);
}

.menu-item {
  min-height: 96rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.menu-item:active {
  background: var(--app-control);
}

.logout-button {
  height: 96rpx;
  margin: 48rpx 32rpx 0;
  border-radius: 16rpx;
  background: var(--app-surface);
  color: var(--app-error);
  font-size: 32rpx;
  font-weight: 500;
  line-height: 96rpx;
}

.logout-button:active {
  background: var(--app-control);
}

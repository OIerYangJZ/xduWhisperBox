.section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #e8e8e8;
  background: #fff;
}

.section-title {
  margin-bottom: 12rpx;
  color: #1d1d1f;
  font-size: 31rpx;
  font-weight: 700;
}

.avatar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  border-bottom: 1rpx solid #e8e8e8;
}

.avatar-preview {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: #f5f5f7;
}

.avatar-button {
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 29rpx;
  background: rgba(21, 94, 117, .1);
  color: #155e75;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 58rpx;
}

.info-row,
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  border-bottom: 1rpx solid #e8e8e8;
  color: #1d1d1f;
  font-size: 28rpx;
}

.info-row:last-child,
.switch-row:last-child {
  border-bottom: none;
}

.info-row text:last-child {
  max-width: 430rpx;
  color: #8e8e93;
  text-align: right;
  word-break: break-all;
}

.row-input {
  width: 430rpx;
  min-height: 64rpx;
  color: #1d1d1f;
  font-size: 28rpx;
  text-align: right;
}

.picker-value {
  min-width: 160rpx;
  color: #8e8e93;
  font-size: 28rpx;
  text-align: right;
}

.bio-field {
  padding: 22rpx 0;
}

.bio-label {
  color: #1d1d1f;
  font-size: 28rpx;
}

.bio-input {
  width: 100%;
  height: 140rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  color: #1d1d1f;
  font-size: 27rpx;
  line-height: 1.5;
}

.save-button,
.safe-button,
.danger-outline-button {
  height: 76rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.save-button,
.safe-button {
  background: #155e75;
  color: #fff;
}

.danger-outline-button {
  border: 1rpx solid #ff3b30;
  background: #fff;
  color: #ff3b30;
}

.safe-button[disabled],
.danger-outline-button[disabled] {
  opacity: .45;
}

.logout-button {
  height: 86rpx;
  border-radius: 12rpx;
  background: #fff;
  color: #ff3b30;
  font-size: 30rpx;
  line-height: 86rpx;
}

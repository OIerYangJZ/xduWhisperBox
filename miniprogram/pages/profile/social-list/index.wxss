.user-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: var(--app-control);
}

.user-body {
  flex: 1;
  min-width: 0;
}

.name {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.bio {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-button {
  width: 108rpx;
  height: 60rpx;
  border-radius: 12rpx;
  background: rgba(21, 94, 117, .1);
  color: var(--app-primary);
  font-size: 26rpx;
  line-height: 60rpx;
}
